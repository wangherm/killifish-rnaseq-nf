/*
    Per-process publishing and CLI arguments.
    Kept out of the module files so that tool arguments can be changed without
    touching the module definition.
*/

process {

    publishDir = [
        path:    { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode:    'copy',
        saveAs:  { fn -> fn.equals('versions.yml') ? null : fn }
    ]

    withName: 'FASTP' {
        ext.args = '--detect_adapter_for_pe'
        publishDir = [
            [ path: { "${params.outdir}/fastp/logs" },   mode: 'copy', pattern: '*.{json,html}' ],
            // Trimmed FASTQs are large and fully regenerable: kept in work/ only.
            [ path: { "${params.outdir}/fastp/reads" },  mode: 'copy', pattern: '*.trimmed.fastq.gz', enabled: false ]
        ]
    }

    withName: 'HISAT2_ALIGN' {
        publishDir = [ path: { "${params.outdir}/hisat2" }, mode: 'copy', pattern: '*.summary.txt' ]
    }

    withName: 'SAMTOOLS_SORT' {
        publishDir = [ path: { "${params.outdir}/alignment" }, mode: 'copy', pattern: '*.{bam,bai}' ]
    }

    withName: 'FEATURECOUNTS' {
        publishDir = [ path: { "${params.outdir}/featurecounts" }, mode: 'copy', pattern: '*.txt*' ]
    }

    withName: 'MERGE_COUNTS' {
        publishDir = [ path: { "${params.outdir}" }, mode: 'copy', pattern: '*.tsv' ]
    }

    withName: 'MULTIQC' {
        publishDir = [ path: { "${params.outdir}/multiqc" }, mode: 'copy' ]
    }
}

/*
    Bulk downstream: differential expression, K13, enrichment
*/
process {
    withName: 'DESEQ2' {
        publishDir = [ path: { "${params.outdir}/differential_expression" }, mode: 'copy', pattern: '*.csv' ]
    }
    withName: 'VST_ALL' {
        publishDir = [ path: { "${params.outdir}" }, mode: 'copy', pattern: 'vst_all.csv' ]
    }
    withName: 'K13_MODULES' {
        publishDir = [ path: { "${params.outdir}/k13" }, mode: 'copy' ]
    }
    withName: 'K13_ENRICHMENT' {
        // Per-module shards are combined by COLLECT_CSV; only the table is published.
        publishDir = [ path: { "${params.outdir}/k13/per_module" }, mode: 'copy', enabled: false ]
    }
    withName: 'COLLECT_DE' {
        publishDir = [ path: { "${params.outdir}" }, mode: 'copy' ]
    }
    withName: 'COLLECT_ENRICHMENT' {
        publishDir = [ path: { "${params.outdir}/k13" }, mode: 'copy' ]
    }
}
