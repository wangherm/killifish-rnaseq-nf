/*
================================================================================
    Default resources
--------------------------------------------------------------------------------
    Replaces the per-script SGE headers:

        #$ -l h_rt=200:00:00
        #$ -l h_vmem=20G
        #$ -pe smp 8

    Those values were copy-pasted into every one of V1.sh - V7.sh, so changing
    them meant editing seven files. Here a process declares a *class* of need
    and the executor decides what that means.

    Every request is clamped to the params.max_* ceilings inline. A retry that
    doubles memory can otherwise silently request more than the queue allows
    and sit pending forever. The clamp is written out per directive rather
    than factored into a helper, because config files are parsed as data and a
    `def` helper here is not reliably visible to the closures below.
================================================================================
*/

process {
    cpus   = { Math.min( 1, params.max_cpus as int ) }
    memory = { def lim = params.max_memory as nextflow.util.MemoryUnit
               def req = 6.GB * task.attempt
               req > lim ? lim : req }
    time   = { def lim = params.max_time as nextflow.util.Duration
               def req = 4.h * task.attempt
               req > lim ? lim : req }

    // 137/139/140 = OOM-kill / segfault / walltime. Retry with more headroom;
    // anything else is a real error and should fail loudly and immediately.
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = { Math.min( 1, params.max_cpus as int ) }
        memory = { def lim = params.max_memory as nextflow.util.MemoryUnit
                   def req = 4.GB * task.attempt
                   req > lim ? lim : req }
        time   = { def lim = params.max_time as nextflow.util.Duration
                   def req = 2.h * task.attempt
                   req > lim ? lim : req }
    }
    withLabel: process_low {
        cpus   = { Math.min( 2 * task.attempt, params.max_cpus as int ) }
        memory = { def lim = params.max_memory as nextflow.util.MemoryUnit
                   def req = 8.GB * task.attempt
                   req > lim ? lim : req }
        time   = { def lim = params.max_time as nextflow.util.Duration
                   def req = 4.h * task.attempt
                   req > lim ? lim : req }
    }
    withLabel: process_medium {
        cpus   = { Math.min( 8 * task.attempt, params.max_cpus as int ) }
        memory = { def lim = params.max_memory as nextflow.util.MemoryUnit
                   def req = 20.GB * task.attempt
                   req > lim ? lim : req }
        time   = { def lim = params.max_time as nextflow.util.Duration
                   def req = 12.h * task.attempt
                   req > lim ? lim : req }
    }
    withLabel: process_high {
        cpus   = { Math.min( 12 * task.attempt, params.max_cpus as int ) }
        memory = { def lim = params.max_memory as nextflow.util.MemoryUnit
                   def req = 48.GB * task.attempt
                   req > lim ? lim : req }
        time   = { def lim = params.max_time as nextflow.util.Duration
                   def req = 24.h * task.attempt
                   req > lim ? lim : req }
    }
}
