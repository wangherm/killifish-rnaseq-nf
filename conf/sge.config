/*
================================================================================
    Son of Grid Engine (UCL CS cluster)
--------------------------------------------------------------------------------
    The original scripts hard-coded these directives in every file:

        #$ -S /bin/bash
        #$ -l h_rt=200:00:00
        #$ -l h_vmem=20G
        #$ -l tmem=20G
        #$ -pe smp 8

    Here they are derived from what each process declared it needs, so the same
    main.nf runs unchanged on a laptop (-profile docker) or on the cluster
    (-profile sge,singularity).
================================================================================
*/

process {
    executor = 'sge'
    penv     = 'smp'
    scratch  = true

    // SGE's `tmem` is PER SLOT, while Nextflow's task.memory is for the whole
    // task. Requesting the total against tmem is the classic way to ask for
    // 8 x 20 GB by accident and never get scheduled.
    clusterOptions = {
        def per_slot = Math.ceil(task.memory.toGiga() / (task.cpus ?: 1)) as int
        "-l tmem=${per_slot}G -S /bin/bash -j y"
    }
}

executor {
    queueSize      = 50
    submitRateLimit = '10 sec'
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "$HOME/.singularity_cache"
}
