/*
================================================================================
    killifish-rnaseq-nf  -  Nextflow config
================================================================================
*/

params {
    // Input / output
    input          = null
    outdir         = null

    // Reference
    fasta          = null
    gtf            = null
    hisat2_index   = null

    // Quantification
    strandedness   = 0          // featureCounts -s : 0 unstranded, 1 fwd, 2 rev
    feature_type   = 'exon'
    attribute_type = 'gene_id'

    // Behaviour
    skip_trimming  = false
    skip_downstream = false
    counts         = null         // pre-built count matrix: skip alignment, run downstream only
    help           = false
    seed           = 0

    // --- Downstream: differential expression and the K13 module map ---------
    // Contrasts are config, not code: adding one adds a parallel DESeq2 task.
    contrasts = [
        entry      : [ test: 'Early Diapause', reference: 'Developing'     ],
        maintenance: [ test: 'Late Diapause',  reference: 'Early Diapause' ],
        exit       : [ test: 'Exit Day 1',     reference: 'Early Diapause' ],
    ]
    min_gene_count  = 10
    lfc_threshold   = 0.5
    padj_threshold  = 0.05

    // K13 gene-programme map. Consumed by the sc-atlas-analysis repository.
    // Defined on the full multi-state VST matrix (all samples), not on one
    // contrast's two conditions.
    k13_k         = 13
    k13_n_init    = 50
    // Canonical C1..C13 ordering: descending mean standardised expression
    // over the samples in this condition. C1 = most early-diapause-associated.
    k13_order_condition = 'Early Diapause'

    // Enrichment queries run on declared orthologues, not uppercased
    // killifish symbols. A module below this mapped fraction fails rather
    // than query Enrichr with a mostly-unmapped gene set.
    orthologues                      = null
    enrichment_min_mapped_fraction   = 0.5
    // Optional path to a cached Enrichr JSON response. When set, the
    // enrichment step reads it instead of querying the live API, which makes
    // a rerun deterministic and offline. null means query Enrichr.
    enrichr_cache                    = null

    // Resource ceilings (guard against a bad label on a shared cluster)
    max_cpus       = 16
    max_memory     = '128.GB'
    max_time       = '200.h'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        conda.enabled       = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }
    conda {
        conda.enabled       = true
        docker.enabled      = false
        singularity.enabled = false
    }
    sge {
        includeConfig 'conf/sge.config'
    }
}

// ---------------------------------------------------------------------------
//  Provenance. The shell scripts produced none of this.
//  The timestamp is inlined: config files are parsed as data, and a `def`
//  variable here is not reliably visible to the blocks below.
// ---------------------------------------------------------------------------
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"   }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.txt"     }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"      }

manifest {
    name            = 'killifish-rnaseq-nf'
    author          = 'Haoyu Wang'
    description     = 'Bulk RNA-seq quantification for Nothobranchius furzeri diapause samples'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}
